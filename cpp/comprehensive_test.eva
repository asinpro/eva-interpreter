# Comprehensive Eva C++ Test

(print "=== Eva C++ Interpreter Test ===")

# Basic arithmetic
(print "Arithmetic: 2 + 3 * 4 =" (+ 2 (* 3 4)))

# Variables
(var x 10)
(var y 20)
(print "Variables: x=" x "y=" y "x+y=" (+ x y))

# Functions with def syntax
(def square (n) (* n n))
(print "Function: square(5) =" (square 5))

# Recursion  
(def factorial (n)
  (if (< n 2)
      1
      (* n (factorial (- n 1)))))
(print "Recursion: factorial(5) =" (factorial 5))

# For loops and increment
(var sum 0)
(for (var i 1) (<= i 5) (++ i)
  (+= sum i))
(print "For loop: sum(1..5) =" sum)

# Classes and objects
(class Point null
  (begin
    (def constructor (this x y)
      (begin
        (set (prop this x) x)
        (set (prop this y) y)))
    (def getSum (this)
      (+ (prop this x) (prop this y)))))

(var p (new Point 3 4))
(var getSum (prop p getSum))
(print "OOP: Point(3,4).getSum() =" (getSum p))

# Modules
(module Math
  (begin
    (def abs (x) (if (< x 0) (- x) x))
    (def max (a b) (if (> a b) a b))))

(var abs (prop Math abs))
(var max (prop Math max))
(print "Modules: abs(-7) =" (abs -7) "max(3,8) =" (max 3 8))

# Switch statement
(var grade "B")
(var description 
  (switch
    ((== grade "A") "Excellent")
    ((== grade "B") "Good")  
    ((== grade "C") "Average")
    (else "Unknown")))
(print "Switch: grade" grade "is" description)

(print "=== All tests completed successfully! ===")